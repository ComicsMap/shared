{
  "name": "@comics-map/shared",
  "version": "0.0.1",
  "private": true,
  "exports": {
    "./constants/*": {
      "types": "./dist/constants/*.d.ts",
      "import": "./dist/constants/*.mjs",
      "require": "./dist/constants/*.cjs"
    },
    "./entities": {
      "types": "./dist/entities/index.d.ts",
      "import": "./dist/entities/index.mjs",
      "require": "./dist/entities/index.cjs"
    },
    "./entities/*": {
      "types": "./dist/entities/*.d.ts",
      "import": "./dist/entities/*.mjs",
      "require": "./dist/entities/*.cjs"
    },
    "./schemas": {
      "types": "./dist/schemas/index.d.ts",
      "import": "./dist/schemas/index.mjs",
      "require": "./dist/schemas/index.cjs"
    },
    "./schemas/*": {
      "types": "./dist/schemas/*.d.ts",
      "import": "./dist/schemas/*.mjs",
      "require": "./dist/schemas/*.cjs"
    },
    "./types": {
      "types": "./dist/types/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src}/**/*.ts\" --fix",
    "makemigrations": "mikro-orm migration:create",
    "migrate": "mikro-orm migration:up",
    "migrate:down": "mikro-orm migration:down",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mikro-orm/cli": "^6.6.7",
    "@mikro-orm/migrations": "^6.6.7",
    "@types/node": "^25.8.0",
    "esbuild-plugin-tsc": "^0.6.0",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "prettier": "^3.8.3",
    "prettier-plugin-jsdoc": "^1.8.0",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-packagejson": "^3.0.2",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3"
  },
  "peerDependencies": {
    "@mikro-orm/core": "^6.6.7",
    "@mikro-orm/postgresql": "^6.6.7",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=22"
  }
}
